        <mxCell id="5" value="3" style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1145" y="815" width="9.5615234375" height="15" />
        </mxCell>
        <mxCell id="6" value="Database-enforced integrity" style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="105" width="175.93261718750003" height="18" />
        </mxCell>
        <mxCell id="7" value="Listing: starting_price &gt; 0; status IN (ACTIVE, INACTIVE)." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="134" width="286.1220703125" height="16" />
        </mxCell>
        <mxCell id="8" value="Offer: offered_price &gt; 0; status IN (PENDING, ACCEPTED, REJECTED, COMPLETED)." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="154" width="435.2451171875" height="16" />
        </mxCell>
        <mxCell id="9" value="Review: 1 &lt;= rating &lt;= 5; offer_id UNIQUE and NOT NULL; all domain foreign keys NOT NULL." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="174" width="470.4794921875" height="16" />
        </mxCell>
        <mxCell id="10" value="All tables shown have primary keys. auth_user.username and auth_group.name are unique." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="194" width="451.60009765625" height="16" />
        </mxCell>
        <mxCell id="11" value="Auth join pairs, permission (content_type_id, codename), and content type (app_label, model) are unique." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="214" width="518.25537109375" height="16" />
        </mxCell>
        <mxCell id="12" value="Explicit marketplace indexes (all confirmed in SQLite)" style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="246" width="335.60156250000006" height="18" />
        </mxCell>
        <mxCell id="13" value="marketplace_status_a6670d_idx: Listing(status, category) - published/category discovery." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="275" width="439.95556640625" height="16" />
        </mxCell>
        <mxCell id="14" value="marketplace_seller__639ce1_idx: Listing(seller_id, status) - seller listings, optionally by status." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="295" width="461.94482421875" height="16" />
        </mxCell>
        <mxCell id="15" value="marketplace_title_7bdd5a_idx: Listing(title) - ordered/equality access; not an arbitrary substring-search accelerator." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="315" width="563.44775390625" height="16" />
        </mxCell>
        <mxCell id="16" value="marketplace_buyer_i_b1e5a0_idx: Offer(buyer_id, status) - buyer dashboard and status filtering." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="335" width="472.37548828125" height="16" />
        </mxCell>
        <mxCell id="17" value="marketplace_listing_6b4340_idx: Offer(listing_id, status) - listing offers and status filtering." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="355" width="441.15869140625" height="16" />
        </mxCell>
        <mxCell id="18" value="Django also creates FK indexes; Review.offer_id uses its unique index. Full inventory is in the notes." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="375" width="492.533203125" height="16" />
        </mxCell>
        <mxCell id="19" value="SQLite INTEGER PRIMARY KEY uses the rowid B-tree; it does not require a separate PK index." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="395" width="474.1533203125" height="16" />
        </mxCell>
        <mxCell id="20" value="Application rules, defaults and delete behavior" style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="427" width="292.22802734375" height="18" />
        </mxCell>
        <mxCell id="21" value="Ownership, Buyer/Seller eligibility, valid state transitions, completed-offer reviews and cross-table author/seller" style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="456" width="540.79248046875" height="16" />
        </mxCell>
        <mxCell id="22" value="consistency are checked in services.py. Foreign keys alone do not enforce these business rules." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="476" width="472.9716796875" height="16" />
        </mxCell>
        <mxCell id="23" value="Django defaults: Listing.status=ACTIVE; Offer.status=PENDING. Timestamps use auto_now_add / auto_now." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="496" width="538.380859375" height="16" />
        </mxCell>
        <mxCell id="24" value="These are ORM behavior, not database DEFAULT clauses or automatic database update triggers." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="516" width="482.14013671875" height="16" />
        </mxCell>
        <mxCell id="25" value="Domain relationships: Django PROTECT. Auth/content-type relationships shown: Django CASCADE." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="536" width="495.56249999999994" height="16" />
        </mxCell>
        <mxCell id="26" value="SQLite reports NO ACTION FK actions; Django implements PROTECT/CASCADE in its deletion collector." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="556" width="520.5595703125" height="16" />
        </mxCell>
        <mxCell id="27" value="Verification and known gaps" style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="588" width="180.24902343750003" height="18" />
        </mxCell>
        <mxCell id="28" value="All migrations applied, including marketplace.0001_initial and 0002_roles; no pending model migrations." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="617" width="509.08691406249994" height="16" />
        </mxCell>
        <mxCell id="29" value="Live column types, nullability, FKs, checks, unique constraints and indexes inspected; PRAGMA foreign_key_check: 0 violations." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="637" width="630.09765625" height="16" />
        </mxCell>
        <mxCell id="30" value="SQLite is active locally. PostgreSQL is supported by settings but Supabase is not configured." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="657" width="456.4716796875" height="16" />
        </mxCell>
        <mxCell id="31" value="Category membership, text lengths, decimal precision and exact one-role-per-user are not database constraints." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="677" width="549.3916015625" height="16" />
        </mxCell>
        <mxCell id="32" value="Review author/seller consistency and completed status have no cross-table database check; direct writes can bypass services." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="697" width="620.9130859375" height="16" />
        </mxCell>
        <mxCell id="33" value="No application code, migrations or database schema changed. Internal session/admin-log tables are omitted from the main ERD." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="717" width="630.1083984375" height="16" />
        </mxCell>
      </root>
    </mxGraphModel>
