        <mxCell id="4" value="FalconXoft | Local vector preview, not a Lucidchart export | PK: primary key; FK: foreign key; UQ: unique; ?: nullable" style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=9;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="815" width="465.89599609375006" height="14" />
