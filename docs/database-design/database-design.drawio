        <mxCell id="108" value="Role and permission implementation" style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="670" width="214.03515625" height="17" />
        </mxCell>
        <mxCell id="109" value="0002_roles creates Buyer/Seller groups and grants model permissions." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="697" width="350.0703125" height="16" />
        </mxCell>
        <mxCell id="110" value="Marketplace authorization checks group membership and record ownership." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="719" width="373.91259765625" height="16" />
        </mxCell>
        <mxCell id="111" value="Django Admin uses staff/model permissions. Direct user grants are supported" style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="741" width="381.84033203125" height="16" />
        </mxCell>
        <mxCell id="112" value="by Django; their join table exists, but role seeding uses group grants." style="text;html=0;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="763" width="337.86181640625" height="16" />
